<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_background_rounded">

    <TextClock
        android:id="@+id/tv_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format24Hour="HH:mm"
        android:format12Hour="hh:mm a"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="86sp" />

    <TextView
        android:id="@+id/tv_widget_weekday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="#F5FFFFFF"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tv_widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#D9FFFFFF"
        android:textSize="18sp" />

</LinearLayout>
